<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>AIMemory.Windows</RootNamespace>
    <Authors>douxy1994</Authors>
    <Copyright>Copyright © 2026 douxy1994</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/douxy1994/AI-Memory</PackageProjectUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <McpRuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</McpRuntimeIdentifier>
    <McpRuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</McpRuntimeIdentifier>
    <McpPublishDir>$(MSBuildProjectDirectory)\obj\McpHelper\$(Configuration)\$(Platform)\</McpPublishDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIMemory.Core\AIMemory.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.*" />
    <Content Include="$(McpPublishDir)aimemory-mcp.exe"
             Link="Helpers\aimemory-mcp.exe"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RecordSourceRevision" BeforeTargets="AssignTargetPaths">
    <Exec
      Command="git -C &quot;$(MSBuildProjectDirectory)\..\..\..&quot; rev-parse --short HEAD"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="AIMemorySourceRevision" />
    </Exec>
    <PropertyGroup>
      <AIMemorySourceRevision Condition="'$(AIMemorySourceRevision)' == ''">uncommitted</AIMemorySourceRevision>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)AIMemorySourceRevision.txt"
      Lines="$(AIMemorySourceRevision)"
      Overwrite="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)AIMemorySourceRevision.txt"
               Link="AIMemorySourceRevision.txt"
               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="PublishNativeMcpHelper" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="..\AIMemory.Mcp\AIMemory.Mcp.csproj"
      Targets="Restore"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(McpRuntimeIdentifier)" />
    <MSBuild
      Projects="..\AIMemory.Mcp\AIMemory.Mcp.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(McpRuntimeIdentifier);PublishDir=$(McpPublishDir);SelfContained=true;PublishSingleFile=true" />
    <MakeDir Directories="$(TargetDir)Helpers" />
    <Copy
      SourceFiles="$(McpPublishDir)aimemory-mcp.exe"
      DestinationFolder="$(TargetDir)Helpers"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
