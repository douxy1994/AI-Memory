<Window
    x:Class="AIMemory.Windows.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Padding="40,34,40,30"
                        Spacing="20"
                        MaxWidth="620"
                        HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Image Source="Assets/Square150x150Logo.png"
                           Width="96"
                           Height="96" />
                    <TextBlock Text="AI Memory"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12"
                                Padding="10,5">
                            <TextBlock x:Name="ReleaseVersionText"
                                       FontSize="12" />
                        </Border>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12"
                                Padding="10,5">
                            <TextBlock x:Name="DevelopmentVersionText"
                                       FontSize="12" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="AboutSubtitle" Text="面向 AI Agent 与 CLI 的本地优先记忆、历史检索和工作接续工具。"
                               MaxWidth="460"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Opacity="0.68" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <Button Click="GitHub_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Source="Assets/GitHubMark.svg"
                                   Width="16"
                                   Height="16" />
                            <TextBlock x:Uid="AboutGitHub" Text="GitHub" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckUpdateButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="CheckUpdateLabel"
                                       x:Uid="AboutCheckUpdate"
                                       Text="检查更新" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <InfoBar x:Name="UpdateStatus"
                         x:Uid="AboutUpdateStatus"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="尚未检查更新" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock x:Uid="AboutLatestRelease" Text="最近版本更新"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ReleaseTagText"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource AIMemoryGreenBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock x:Uid="AboutChangelogSync" Text="✓ 增量同步更可靠&#x0a;WebDAV 与本地备份只传输发生变化的内容。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Uid="AboutChangelogData" Text="✓ 数据管理更清晰&#x0a;同步、数据位置、导入、备份与恢复集中管理。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="AgentCoverageText"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Uid="AboutChangelogNative" Text="✓ Windows 原生体验&#x0a;使用 WinUI 3、Windows App SDK 与系统凭据保险箱。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="AboutSoftwareTitle" Text="关于本软件"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="AboutSoftwareBody" Text="AI Memory 是一款本地优先的 AI 工作记忆工具。它将不同 AI Agent 与命令行工具产生的对话历史、记忆规则、检查点和交接信息集中到一个原生工作台，帮助你快速找回上下文、检索过去的工作，并从上次中断的位置继续。&#x0a;&#x0a;所有核心数据均由本机管理，兼顾隐私、可靠性与长期可用性。"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock x:Uid="AboutFooter" Text="本地优先 · 独立数据 · 原生 Windows 11"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                    <TextBlock x:Uid="AboutCopyright" Text="Copyright © 2026 douxy1994"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                    <TextBlock x:Uid="AboutLicense"
                               Text="Licensed under the GNU Affero General Public License v3.0 (AGPL-3.0-only)"
                               FontSize="11"
                               Opacity="0.55" />
                    <TextBlock Text="Package  com.aimemory.windows"
                               FontFamily="Cascadia Mono"
                               FontSize="11"
                               Opacity="0.55" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
