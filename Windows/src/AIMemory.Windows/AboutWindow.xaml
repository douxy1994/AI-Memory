<Window
    x:Class="AIMemory.Windows.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource WindowBackgroundBrush}">
        <ScrollViewer>
            <StackPanel Padding="40,34,40,30"
                        Spacing="20"
                        MaxWidth="760"
                        HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Border Background="{ThemeResource AIMemoryGreenSoftBrush}"
                            CornerRadius="22"
                            Padding="6">
                        <Image Source="Assets/Square150x150Logo.png"
                               Width="96"
                               Height="96" />
                    </Border>
                    <TextBlock Text="AI Memory"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Border Style="{ThemeResource TagChipStyle}">
                            <TextBlock x:Name="ReleaseVersionText"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{ThemeResource TagChipStyle}">
                            <TextBlock x:Name="DevelopmentVersionText"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="AboutSubtitle" Text="面向 AI Agent 与 CLI 的本地优先记忆、历史检索和工作接续工具。"
                               MaxWidth="460"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SubtleTextBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <Button Style="{ThemeResource GhostPillButtonStyle}"
                            Click="GitHub_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Source="Assets/GitHubMark.svg"
                                   Width="16"
                                   Height="16" />
                            <TextBlock x:Uid="AboutGitHub" Text="GitHub" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckUpdateButton"
                            Style="{ThemeResource PrimaryPillButtonStyle}"
                            Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="CheckUpdateLabel"
                                       x:Uid="AboutCheckUpdate"
                                       Text="检查更新" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <InfoBar x:Name="UpdateStatus"
                         x:Uid="AboutUpdateStatus"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="尚未检查更新" />

                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="SettingsAutoUpdateTitle"
                                           Text="自动检查更新"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsAutoUpdateHint"
                                           Text="从 AI Memory 的 GitHub Releases 获取正式版本。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource SubtleTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoUpdateToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="UpdateFeedBox"
                                 Header="GitHub Releases API"
                                 PlaceholderText="https://api.github.com/repos/owner/repository/releases/latest" />
                        <Button x:Uid="AboutSaveUpdateButton"
                                Content="保存更新设置"
                                HorizontalAlignment="Right"
                                Click="SaveUpdateSettings_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="SettingsReadinessTitle"
                                   Text="升级就绪检查"
                                   Style="{ThemeResource SectionTitleStyle}" />
                        <TextBlock x:Uid="SettingsReadinessHint"
                                   Text="验证设置文件、WebDAV 配置、凭据和数据库，提前发现会阻断升级的问题。"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SubtleTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RunReadinessButton"
                                    x:Uid="AboutRunReadinessButton"
                                    Content="运行升级就绪检查"
                                    Click="RunReadiness_Click" />
                            <ProgressRing x:Name="ReadinessProgress"
                                          Width="20"
                                          Height="20"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="ReadinessSummary"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="ReadinessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,7" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusGlyph}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                   HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SubtleTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="SettingsDiagnosticsTitle"
                                   Text="运行诊断"
                                   Style="{ThemeResource SectionTitleStyle}" />
                        <TextBlock x:Uid="SettingsDiagnosticsHint"
                                   Text="以下内容来自当前数据库与本机环境，可用于核对版本、数据和 Agent 状态。"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SubtleTextBrush}" />
                        <TextBox x:Name="DiagnosticsBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="180"
                                 FontFamily="Cascadia Mono" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button x:Uid="AboutRefreshDiagnosticsButton"
                                    Content="刷新诊断"
                                    Click="RefreshDiagnostics_Click" />
                            <Button x:Uid="AboutCopyDiagnosticsButton"
                                    Content="复制诊断"
                                    Click="CopyDiagnostics_Click" />
                            <Button x:Uid="AboutOpenDataFolderButton"
                                    Content="打开数据目录"
                                    Click="OpenDataDirectory_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;"
                                          FontSize="15"
                                          Foreground="{ThemeResource AIMemoryGreenBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Uid="AboutLatestRelease" Text="最近版本更新"
                                           Style="{ThemeResource SectionTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ReleaseTagText"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource AIMemoryGreenBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock x:Uid="AboutChangelogSync" Text="✓ 增量同步更可靠&#x0a;WebDAV 与本地备份只传输发生变化的内容。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Uid="AboutChangelogData" Text="✓ 数据管理更清晰&#x0a;同步、数据位置、导入、备份与恢复集中管理。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="AgentCoverageText"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Uid="AboutChangelogNative" Text="✓ Windows 原生体验&#x0a;使用 WinUI 3、Windows App SDK 与系统凭据保险箱。"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </Border>

                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="15"
                                      Foreground="{ThemeResource AIMemoryGreenBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Uid="AboutSoftwareTitle" Text="关于本软件"
                                       Style="{ThemeResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Uid="AboutSoftwareBody" Text="AI Memory 是一款本地优先的 AI 工作记忆工具。它将不同 AI Agent 与命令行工具产生的对话历史、记忆规则、检查点和交接信息集中到一个原生工作台，帮助你快速找回上下文、检索过去的工作，并从上次中断的位置继续。&#x0a;&#x0a;所有核心数据均由本机管理，兼顾隐私、可靠性与长期可用性。"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock x:Uid="AboutFooter" Text="本地优先 · 独立数据 · 原生 Windows 11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource SubtleTextBrush}" />
                    <TextBlock x:Uid="AboutCopyright" Text="Copyright © 2026 douxy1994"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource SubtleTextBrush}" />
                    <TextBlock x:Uid="AboutLicense"
                               Text="Licensed under the GNU Affero General Public License v3.0 (AGPL-3.0-only)"
                               FontSize="11"
                               Foreground="{ThemeResource SubtleTextBrush}"
                               Opacity="0.8" />
                    <TextBlock Text="Package  com.aimemory.windows"
                               FontFamily="Cascadia Mono"
                               FontSize="11"
                               Foreground="{ThemeResource SubtleTextBrush}"
                               Opacity="0.8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
