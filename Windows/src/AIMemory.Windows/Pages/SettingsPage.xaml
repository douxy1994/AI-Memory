<Page
    x:Class="AIMemory.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Uid="SettingsTitle" Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SettingsSubtitle" Text="管理启动、Agent 集成、数据同步与备份以及软件更新。"
                       Opacity="0.65" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="SettingsCategories"
                      SelectionMode="Single"
                      SelectionChanged="SettingsCategories_SelectionChanged">
                <ListViewItem Tag="general">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock x:Uid="SettingsCategoryGeneral" Text="常规" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="agents">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="World" />
                        <TextBlock x:Uid="SettingsCategoryAgents" Text="Agent 集成" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="sync">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Sync" />
                        <TextBlock x:Uid="SettingsCategorySync" Text="数据同步与备份" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="updates">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Download" />
                        <TextBlock x:Uid="SettingsCategoryUpdates" Text="更新与诊断" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="820" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="GeneralPanel" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SettingsGeneralTitle" Text="常规"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Uid="SettingsGeneralSubtitle" Text="控制字体、登录启动、记忆恢复点和自动备份。"
                                       Opacity="0.65" />
                        </StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="SettingsLanguageFontTitle" Text="语言与字体"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <ComboBox x:Name="LanguageBox"
                                          x:Uid="SettingsLanguage"
                                          Header="界面语言"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="LanguageBox_SelectionChanged" />
                                <TextBlock x:Name="LanguageRestartHint"
                                           x:Uid="SettingsLanguageRestartHint"
                                           Text="语言更改将在重新启动 AI Memory 后生效。"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                                <ComboBox x:Name="FontFamilyBox"
                                          x:Uid="SettingsFont"
                                          Header="字体"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="FontFamilyBox_SelectionChanged" />
                                <TextBlock x:Uid="SettingsFontHint" Text="字体会立即应用；所选字体未安装时由 Windows 自动回退到系统字体。"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="SettingsStartupTitle" Text="登录时自动启动"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="StartupDetail"
                                               x:Uid="SettingsStartupLoading"
                                               Text="正在读取系统状态…"
                                               TextWrapping="Wrap"
                                               Opacity="0.6" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="StartupToggle"
                                                  HorizontalAlignment="Right"
                                                  Toggled="StartupToggle_Toggled" />
                                    <Button x:Name="OpenStartupSettingsButton"
                                            x:Uid="SettingsOpenStartupSettings"
                                            Content="打开启动应用设置"
                                            Visibility="Collapsed"
                                            Click="OpenStartupSettings_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsAutoBackupTitle" Text="自动恢复与备份"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="SettingsAutoCaptureTitle" Text="自动保留记忆恢复点"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Uid="SettingsAutoCaptureHint" Text="打开对话后刷新对应 Agent 来源，并持续更新该对话唯一的自动检查点。"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoCaptureToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="SettingsAutoBackupToggleTitle" Text="定时备份数据库与设置"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Uid="SettingsAutoBackupHint" Text="没有变化时不会生成重复恢复点；未变化的文件使用 NTFS 硬链接复用。"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoBackupToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <NumberBox x:Name="AutoBackupIntervalBox"
                                           x:Uid="SettingsBackupInterval"
                                           Header="备份间隔（分钟）"
                                           Minimum="5"
                                           Maximum="1440"
                                           SmallChange="5"
                                           SpinButtonPlacementMode="Inline" />
                                <Button x:Uid="SettingsSaveAutoBackup" Content="保存自动备份设置"
                                        HorizontalAlignment="Right"
                                        Click="SaveGeneralSettings_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AgentsPanel"
                                Spacing="16"
                                Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="SettingsAgentsTitle" Text="Agent 集成"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsAgentsSubtitle" Text="已安装项目优先显示；未安装项目保持关闭。"
                                           TextWrapping="Wrap"
                                           Opacity="0.65" />
                            </StackPanel>
                            <CommandBar x:Name="AgentCommandBar"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        HorizontalAlignment="Right"
                                        DefaultLabelPosition="Right"
                                        IsDynamicOverflowEnabled="True">
                                <AppBarButton x:Uid="SettingsInstallAllAgents"
                                              Icon="Download"
                                              Label="全部安装"
                                              Click="InstallAllAgents_Click" />
                                <AppBarButton x:Uid="SettingsUninstallAllAgents"
                                              Icon="Remove"
                                              Label="全部卸载"
                                              Click="UninstallAllAgents_Click" />
                                <AppBarButton x:Uid="SettingsDetectAgents"
                                              Icon="Refresh"
                                              Label="重新检测"
                                              Click="DetectAgents_Click" />
                            </CommandBar>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl x:Name="AgentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,9" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.6" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding State}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding ActionLabel}"
                                                    IsEnabled="{Binding CanToggle}"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="ToggleAgent_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SyncPanel"
                                Spacing="16"
                                Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SettingsSyncTitle" Text="数据同步与备份"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Uid="SettingsSyncSubtitle" Text="集中管理本地目录、WebDAV、历史导入和恢复点。"
                                       TextWrapping="Wrap"
                                       Opacity="0.65" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsLocalSyncTitle" Text="本地同步目录"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsLocalSyncHint" Text="适用于 OneDrive、Dropbox、Google Drive 等共享目录；只传输变化的对话文件。"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                                <TextBox x:Name="SyncFolderBox"
                                         x:Uid="SettingsLocalSyncFolder"
                                         PlaceholderText="例如 D:\OneDrive\AI Memory" />
                                <CommandBar Background="Transparent"
                                            HorizontalAlignment="Right"
                                            DefaultLabelPosition="Right">
                                    <AppBarButton x:Uid="SettingsChooseFolder"
                                                  Icon="Folder"
                                                  Label="选择目录"
                                                  Click="ChooseLocalFolder_Click" />
                                    <AppBarButton x:Uid="SettingsSaveFolder"
                                                  Icon="Save"
                                                  Label="保存目录"
                                                  Click="SaveLocalFolder_Click" />
                                    <AppBarButton x:Uid="SettingsCheckCloudReadiness"
                                                  Icon="Accept"
                                                  Label="检测云盘状态"
                                                  Click="CheckCloudReadiness_Click" />
                                    <AppBarButton x:Uid="SettingsSyncFolderNow"
                                                  Icon="Sync"
                                                  Label="立即同步"
                                                  Click="SyncLocalFolder_Click" />
                                </CommandBar>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsWebDavTitle" Text="WebDAV"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SchemeBox" SelectedIndex="0">
                                        <ComboBoxItem Content="https" />
                                        <ComboBoxItem Content="http" />
                                    </ComboBox>
                                    <TextBox x:Name="HostBox"
                                             Grid.Column="1"
                                             PlaceholderText="dav.example.com" />
                                </Grid>
                                <StackPanel Spacing="10">
                                    <TextBox x:Name="ServerPathBox"
                                             x:Uid="SettingsWebDavServerPath"
                                             PlaceholderText="服务器路径，例如 webdav" />
                                    <TextBox x:Name="RemotePathBox"
                                             x:Uid="SettingsWebDavRemotePath"
                                             PlaceholderText="远程目录，例如 aimemory" />
                                    <TextBox x:Name="UsernameBox"
                                             x:Uid="SettingsWebDavUsername"
                                             PlaceholderText="用户名" />
                                    <PasswordBox x:Name="PasswordBox"
                                                 x:Uid="SettingsWebDavPassword"
                                                 PlaceholderText="密码" />
                                </StackPanel>
                                <CommandBar Background="Transparent"
                                            HorizontalAlignment="Right"
                                            DefaultLabelPosition="Right">
                                    <AppBarButton x:Uid="SettingsVerifyWebDav"
                                                  Icon="Accept"
                                                  Label="验证连接"
                                                  Click="VerifyWebDav_Click" />
                                    <AppBarButton x:Uid="SettingsSyncWebDavNow"
                                                  Icon="Sync"
                                                  Label="立即同步"
                                                  Click="SyncWebDav_Click" />
                                    <AppBarButton x:Uid="SettingsSaveWebDav"
                                                  Icon="Save"
                                                  Label="保存"
                                                  Click="SaveSettings_Click" />
                                </CommandBar>
                                <ProgressBar x:Name="SyncProgress"
                                             IsIndeterminate="True"
                                             Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsRecoveryTitle" Text="数据与恢复"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DataPathText"
                                           TextWrapping="Wrap"
                                           Opacity="0.65"
                                           IsTextSelectionEnabled="True" />
                                <CommandBar Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            DefaultLabelPosition="Right">
                                    <AppBarButton x:Uid="SettingsCreateRecoveryPoint"
                                                  Icon="SaveLocal"
                                                  Label="创建恢复点"
                                                  Click="CreateBackup_Click" />
                                    <AppBarButton x:Uid="SettingsRestoreRecoveryPoint"
                                                  Icon="Refresh"
                                                  Label="从恢复点恢复"
                                                  Click="RestoreBackup_Click" />
                                    <AppBarButton x:Uid="SettingsOpenBackupFolder"
                                                  Icon="Folder"
                                                  Label="打开备份目录"
                                                  Click="OpenBackupDirectory_Click" />
                                    <AppBarButton x:Uid="SettingsImportAgentHistory"
                                                  Icon="Download"
                                                  Label="导入本机 Agent 历史"
                                                  Click="ImportNativeHistory_Click" />
                                    <AppBarButton x:Name="ImportChatMemButton"
                                                  x:Uid="SettingsImportChatMem"
                                                  Icon="Download"
                                                  Label="导入 ChatMem 数据"
                                                  Click="ImportChatMem_Click" />
                                </CommandBar>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="UpdatesPanel"
                                Spacing="16"
                                Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SettingsUpdatesTitle" Text="更新与诊断"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Uid="SettingsUpdatesSubtitle" Text="配置自动检查更新，并查看当前本机运行状态。"
                                       TextWrapping="Wrap"
                                       Opacity="0.65" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsSoftwareUpdateTitle" Text="软件更新"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="SettingsAutoUpdateTitle" Text="自动检查更新"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Uid="SettingsAutoUpdateHint" Text="从 AI Memory 的 GitHub Releases 获取正式版本。"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoUpdateToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <TextBox x:Name="UpdateFeedBox"
                                         Header="GitHub Releases API"
                                         PlaceholderText="https://api.github.com/repos/owner/repository/releases/latest" />
                                <CommandBar Background="Transparent"
                                            HorizontalAlignment="Right"
                                            DefaultLabelPosition="Right">
                                    <AppBarButton x:Uid="SettingsSaveUpdate"
                                                  Icon="Save"
                                                  Label="保存更新设置"
                                                  Click="SaveUpdateSettings_Click" />
                                    <AppBarButton x:Uid="SettingsCheckUpdateAbout"
                                                  Icon="Refresh"
                                                  Label="在关于中检查更新"
                                                  Click="CheckUpdates_Click" />
                                </CommandBar>
                                <TextBlock x:Name="UpdateStatusText"
                                           x:Uid="SettingsUpdateStatus"
                                           Text="更新检查与安装统一在“关于 AI Memory”窗口中完成。"
                                           TextWrapping="Wrap"
                                           Opacity="0.65" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsReadinessTitle"
                                           Text="升级就绪检查"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsReadinessHint"
                                           Text="验证设置文件、WebDAV 配置、凭据和数据库，提前发现会阻断升级的问题。"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <AppBarButton x:Name="RunReadinessButton"
                                                  x:Uid="SettingsRunReadiness"
                                                  Icon="Accept"
                                                  Label="运行升级就绪检查"
                                                  Click="RunReadiness_Click" />
                                    <ProgressRing x:Name="ReadinessProgress"
                                                  Width="20"
                                                  Height="20"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReadinessSummary"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl x:Name="ReadinessList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,7"
                                                  ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusGlyph}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.65" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="SettingsDiagnosticsTitle" Text="运行诊断"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsDiagnosticsHint" Text="以下内容来自当前数据库与本机环境，可用于核对版本、数据和 Agent 状态。"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                                <TextBox x:Name="DiagnosticsBox"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="180"
                                         FontFamily="Cascadia Mono" />
                                <CommandBar Background="Transparent"
                                            HorizontalAlignment="Right"
                                            DefaultLabelPosition="Right">
                                    <AppBarButton x:Uid="SettingsRefreshDiagnostics"
                                                  Icon="Refresh"
                                                  Label="刷新诊断"
                                                  Click="RefreshDiagnostics_Click" />
                                    <AppBarButton x:Uid="SettingsCopyDiagnostics"
                                                  Icon="Copy"
                                                  Label="复制诊断"
                                                  Click="CopyDiagnostics_Click" />
                                    <AppBarButton x:Uid="SettingsOpenDataFolder"
                                                  Icon="Folder"
                                                  Label="打开数据目录"
                                                  Click="OpenDataDirectory_Click" />
                                </CommandBar>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="3"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
