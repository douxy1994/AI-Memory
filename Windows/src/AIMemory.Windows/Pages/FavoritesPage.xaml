<Page
    x:Class="AIMemory.Windows.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Uid="FavoritesTitle" Text="收藏" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="FavoritesSubtitle" Text="收藏保存轻量快照，不复制或移动原始对话。"
                       Opacity="0.65" />
        </StackPanel>

        <ListView x:Name="FavoritesList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE734;"
                                          Foreground="{StaticResource AIMemoryGreenBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceAndProject}"
                                               TextWrapping="Wrap"
                                               Opacity="0.6" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PinLabel}"
                                           Foreground="{StaticResource AIMemoryGreenBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBox x:Uid="FavoritesNote"
                                         Header="备注"
                                         PlaceholderText="这段对话为什么重要？"
                                         Text="{Binding Note, Mode=TwoWay}" />
                                <TextBox x:Uid="FavoritesTags"
                                         Header="标签"
                                         PlaceholderText="例如：发布, 修复"
                                         Text="{Binding TagsText, Mode=TwoWay}" />
                            </StackPanel>

                            <CommandBar Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Pin"
                                              Label="{Binding PinActionLabel}"
                                              Tag="{Binding}"
                                              Click="TogglePin_Click" />
                                <AppBarButton x:Uid="FavoritesSaveMetadata"
                                              Icon="Save"
                                              Label="保存备注与标签"
                                              Tag="{Binding}"
                                              Click="SaveMetadata_Click" />
                                <AppBarButton x:Uid="FavoritesOpenConversation"
                                              Icon="OpenFile"
                                              Label="打开对话"
                                              Tag="{Binding}"
                                              Click="OpenConversation_Click" />
                                <AppBarButton x:Uid="FavoritesCopyCard"
                                              Icon="Copy"
                                              Label="复制继续卡片"
                                              Tag="{Binding}"
                                              Click="CopyCard_Click" />
                                <AppBarButton x:Uid="FavoritesRemove"
                                              Icon="Remove"
                                              Label="取消收藏"
                                              Tag="{Binding}"
                                              Click="RemoveFavorite_Click" />
                            </CommandBar>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText"
                   x:Uid="FavoritesEmpty"
                   Grid.Row="1"
                   Text="暂无收藏。在对话详情中点击“收藏”后，对话会显示在这里。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Opacity="0.6"
                   Visibility="Collapsed" />
        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="2"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
