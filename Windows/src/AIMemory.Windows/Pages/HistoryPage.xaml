<Page
    x:Class="AIMemory.Windows.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="历史" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="对话、记忆、检查点、交接、运行与产出的统一资料库。" Opacity="0.65" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="刷新" Click="Refresh_Click" />
        </Grid>
        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Margin="0,0,130,0"
                 PlaceholderText="搜索本地历史"
                 TextChanged="SearchBox_TextChanged" />
        <Button Grid.Row="1"
                Content="移到回收站"
                HorizontalAlignment="Right"
                Margin="0,0,8,0"
                Click="TrashSelected_Click" />
        <ListView x:Name="ConversationList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ConversationList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AIMemoryGreenBrush}" CornerRadius="4" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SourceAgent}" Opacity="0.65" />
                                <TextBlock Text="{Binding RepoId}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding UpdatedAt}" Opacity="0.55" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText"
                   Grid.Row="2"
                   Text="还没有可显示的历史。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   Visibility="Collapsed" />
    </Grid>
</Page>
