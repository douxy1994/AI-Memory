<Page
    x:Class="AIMemory.Windows.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="HistoryTitle" Text="历史" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="HistorySubtitle" Text="对话、记忆、检查点、交接、运行、产物与经历的统一资料库。"
                           TextWrapping="Wrap"
                           Opacity="0.65" />
            </StackPanel>
            <Button x:Uid="HistoryRefresh"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="刷新"
                    Click="Refresh_Click" />
        </Grid>

        <TabView Grid.Row="1">
            <TabViewItem x:Uid="HistoryConversationsTab" Header="对话" IsClosable="False">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox"
                             x:Uid="HistorySearch"
                             PlaceholderText="搜索本地历史"
                             TextChanged="SearchBox_TextChanged" />
                    <CommandBar Grid.Row="1"
                                DefaultLabelPosition="Right"
                                IsOpen="False">
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="SourceBox"
                                          x:Uid="HistorySourceFilter"
                                          Header="来源"
                                          Width="180"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SourceBox_SelectionChanged" />
                                <DropDownButton x:Name="ProjectFilterButton"
                                                x:Uid="HistoryProjectFilter"
                                                Content="全部项目" />
                                <ComboBox x:Name="SortBox"
                                          x:Uid="HistorySort"
                                          Header="排序"
                                          Width="180"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SortBox_SelectionChanged" />
                            </StackPanel>
                        </CommandBar.Content>
                        <AppBarButton x:Name="BeginSelectionButton"
                                      x:Uid="HistoryBeginSelection"
                                      Label="批量选择"
                                      Click="BeginSelection_Click">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="SelectAll" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="CancelSelectionButton"
                                      x:Uid="HistoryCancelSelection"
                                      Label="取消"
                                      Visibility="Collapsed"
                                      Click="CancelSelection_Click">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Cancel" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="TrashSelectedButton"
                                      x:Uid="HistoryTrashSelected"
                                      Label="移到回收站"
                                      Visibility="Collapsed"
                                      IsEnabled="False"
                                      Click="TrashSelected_Click">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <ListView x:Name="ConversationList"
                              Grid.Row="2"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              SelectionChanged="ConversationList_SelectionChanged"
                              ItemClick="ConversationList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AIMemoryGreenBrush}"
                                            CornerRadius="4" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Summary}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding SourceAgent}"
                                                       Opacity="0.65" />
                                            <TextBlock Text="{Binding RepoId}"
                                                       Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding UpdatedAt}"
                                               Opacity="0.55" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText"
                               x:Uid="HistoryNoConversations"
                               Grid.Row="2"
                               Text="还没有可显示的对话。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </Grid>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryMemoryTab" Header="记忆" IsClosable="False">
                <ListView x:Name="MemoryList"
                          IsItemClickEnabled="True"
                          ItemClick="MemoryList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Value}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock x:Uid="HistoryOpenMemory" Text="打开记忆管理"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryCheckpointsTab" Header="检查点" IsClosable="False">
                <ListView x:Name="CheckpointList"
                          IsItemClickEnabled="True"
                          ItemClick="CheckpointList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Summary}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceAgent}"
                                               Opacity="0.6" />
                                    <TextBlock Text="{Binding CreatedAt}"
                                               Opacity="0.55" />
                                    <TextBlock x:Uid="HistoryOpenSourceCheckpoint" Text="打开来源对话"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryHandoffsTab" Header="交接" IsClosable="False">
                <ListView x:Name="HandoffList"
                          IsItemClickEnabled="True"
                          ItemClick="HandoffList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding CurrentGoal}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FromAgent}"
                                               Opacity="0.6" />
                                    <TextBlock Text="{Binding ToAgent}"
                                               Opacity="0.6" />
                                    <TextBlock x:Uid="HistoryOpenSourceHandoff" Text="打开来源对话"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryRunsTab" Header="运行" IsClosable="False">
                <ListView x:Name="RunList"
                          IsItemClickEnabled="True"
                          ItemClick="RunList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock Text="{Binding Status}"
                                               Opacity="0.6" />
                                    <TextBlock x:Uid="HistoryOpenSourceRun" Text="打开来源对话"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryArtifactsTab" Header="产物" IsClosable="False">
                <ListView x:Name="ArtifactList"
                          IsItemClickEnabled="True"
                          ItemClick="ArtifactList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock Text="{Binding TrustState}"
                                               Opacity="0.6" />
                                    <TextBlock x:Uid="HistoryOpenArtifactSource" Text="查看产生该产物的对话"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryEpisodesTab" Header="经历" IsClosable="False">
                <ListView x:Name="EpisodeList"
                          IsItemClickEnabled="True"
                          ItemClick="EpisodeList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock Text="{Binding Outcome}"
                                               Opacity="0.6" />
                                    <TextBlock x:Uid="HistoryOpenSourceEpisode" Text="打开来源对话"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryWikiTab" Header="Wiki" IsClosable="False">
                <ListView x:Name="WikiList"
                          IsItemClickEnabled="True"
                          ItemClick="WikiList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Body}"
                                               TextWrapping="Wrap"
                                               MaxLines="4" />
                                    <TextBlock x:Uid="HistoryOpenWiki" Text="查看完整页面"
                                               Foreground="{StaticResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
        </TabView>

        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="2"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
