<Page
    x:Class="AIMemory.Windows.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource WindowBackgroundBrush}"
          Padding="32"
          RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题白卡 -->
        <Border Style="{ThemeResource CardStyle}">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="HistoryTitle" Text="历史" Style="{ThemeResource PageTitleStyle}" />
                    <TextBlock x:Uid="HistorySubtitle" Text="对话、记忆、检查点、交接、运行、产物与经历的统一资料库。"
                               Style="{ThemeResource PageSubtitleStyle}" />
                </StackPanel>
                <Button x:Uid="HistoryRefresh"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="刷新"
                        Style="{ThemeResource GhostPillButtonStyle}"
                        Click="Refresh_Click" />
            </Grid>
        </Border>

        <TabView Grid.Row="1"
                 HorizontalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch">
            <TabView.Resources>
                <Style TargetType="TabViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </TabView.Resources>
            <TabViewItem x:Uid="HistoryConversationsTab" Header="对话" IsClosable="False">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox"
                             x:Uid="HistorySearch"
                             PlaceholderText="搜索本地历史"
                             TextChanged="SearchBox_TextChanged" />
                    <CommandBar Grid.Row="1"
                                Background="Transparent"
                                DefaultLabelPosition="Right"
                                IsOpen="False">
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="SourceBox"
                                          x:Uid="HistorySourceFilter"
                                          Header="来源"
                                          Width="180"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SourceBox_SelectionChanged" />
                                <DropDownButton x:Name="ProjectFilterButton"
                                                x:Uid="HistoryProjectFilter"
                                                Content="全部项目" />
                                <ComboBox x:Name="ArrangeBox"
                                          x:Uid="HistoryArrange"
                                          Header="排列"
                                          Width="160"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="ArrangeBox_SelectionChanged" />
                                <ComboBox x:Name="SortBox"
                                          x:Uid="HistorySort"
                                          Header="排序"
                                          Width="180"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SortBox_SelectionChanged" />
                            </StackPanel>
                        </CommandBar.Content>
                        <AppBarButton x:Name="BeginSelectionButton"
                                      x:Uid="HistoryBeginSelection"
                                      Label="批量选择"
                                      Click="BeginSelection_Click">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="SelectAll" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="CancelSelectionButton"
                                      x:Uid="HistoryCancelSelection"
                                      Label="取消"
                                      Visibility="Collapsed"
                                      Click="CancelSelection_Click">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Cancel" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="TrashSelectedButton"
                                      x:Uid="HistoryTrashSelected"
                                      Label="移到回收站"
                                      Visibility="Collapsed"
                                      IsEnabled="False"
                                      Click="TrashSelected_Click">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <ListView x:Name="ConversationList"
                              Grid.Row="2"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              SelectionChanged="ConversationList_SelectionChanged"
                              ItemClick="ConversationList_ItemClick">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,12,10,6"
                                              ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}"
                                                           Foreground="{ThemeResource SubtleTextBrush}"
                                                           FontFamily="Cascadia Mono"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource AIMemoryGreenSoftBrush}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}"
                                                           Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{ThemeResource CardStyle}" Padding="14" Margin="0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Style="{ThemeResource TagChipStyle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceAgent}"
                                                               Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                               FontSize="12" />
                                                </Border>
                                                <TextBlock Text="{Binding Summary}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RepoId}"
                                                       Foreground="{ThemeResource SubtleTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpdatedAt}"
                                                   Foreground="{ThemeResource SubtleTextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText"
                               x:Uid="HistoryNoConversations"
                               Grid.Row="2"
                               Text="还没有可显示的对话。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SubtleTextBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryMemoryTab" Header="记忆" IsClosable="False">
                <ListView x:Name="MemoryList"
                          IsItemClickEnabled="True"
                          ItemClick="MemoryList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Value}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock x:Uid="HistoryOpenMemory" Text="打开记忆管理"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryLocalIndexTab" Header="本地索引" IsClosable="False">
                <ScrollViewer>
                    <StackPanel Spacing="14" Padding="0,4,0,12">
                        <Border Style="{ThemeResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="HistoryLocalIndexTitle"
                                           Text="本地历史索引"
                                           Style="{ThemeResource SectionTitleStyle}" />
                                <TextBlock x:Uid="HistoryLocalIndexHint"
                                           Text="扫描本地 Agent 历史、检查索引状态并维护仓库投影。"
                                           Style="{ThemeResource PageSubtitleStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocalIndexRepoRootBox"
                                             x:Uid="HistoryLocalIndexRepoRoot"
                                             Header="仓库根目录"
                                             PlaceholderText="D:\path\to\repository" />
                                    <Button x:Uid="HistoryLocalIndexUseCurrent"
                                            Grid.Column="1"
                                            Content="使用当前项目"
                                            VerticalAlignment="Bottom"
                                            Style="{ThemeResource GhostPillButtonStyle}"
                                            Click="UseCurrentProject_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{ThemeResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="HistoryLocalIndexStatusTitle"
                                           Text="索引状态"
                                           Style="{ThemeResource SectionTitleStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{ThemeResource StatCardStyle}" MinHeight="100">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LocalIndexScannedText" Text="—" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="HistoryLocalIndexScanned" Text="扫描对话" Foreground="{ThemeResource SubtleTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{ThemeResource StatCardStyle}" MinHeight="100">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LocalIndexLinkedText" Text="—" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="HistoryLocalIndexLinked" Text="已索引对话" Foreground="{ThemeResource SubtleTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{ThemeResource StatCardStyle}" MinHeight="100">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LocalIndexCandidatesText" Text="—" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="HistoryLocalIndexCandidates" Text="候选规则" Foreground="{ThemeResource SubtleTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{ThemeResource StatCardStyle}" MinHeight="100">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LocalIndexMemoriesText" Text="—" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="HistoryLocalIndexMemories" Text="已批准记忆" Foreground="{ThemeResource SubtleTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="LocalIndexDocumentsText"
                                           Foreground="{ThemeResource SubtleTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{ThemeResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock x:Uid="HistoryLocalIndexActionsTitle"
                                               Text="操作"
                                               Style="{ThemeResource SectionTitleStyle}" />
                                    <ProgressRing x:Name="LocalIndexProgress"
                                                  HorizontalAlignment="Right"
                                                  Width="22"
                                                  Height="22"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                </Grid>
                                <CommandBar Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            DefaultLabelPosition="Right">
                                    <AppBarButton x:Uid="HistoryLocalIndexScan"
                                                  Icon="Find"
                                                  Label="扫描"
                                                  Click="ScanLocalIndex_Click" />
                                    <AppBarButton x:Uid="HistoryLocalIndexImportAll"
                                                  Icon="Download"
                                                  Label="导入全部"
                                                  Click="ImportAllLocalHistory_Click" />
                                    <AppBarButton x:Uid="HistoryLocalIndexMergeAlias"
                                                  Icon="Link"
                                                  Label="合并别名"
                                                  Click="MergeLocalIndexAlias_Click" />
                                    <AppBarButton x:Uid="HistoryLocalIndexRebuildWiki"
                                                  Icon="Document"
                                                  Label="重建 Wiki"
                                                  Click="RebuildLocalIndexWiki_Click" />
                                    <AppBarButton x:Uid="HistoryLocalIndexRebuildSearch"
                                                  Icon="Refresh"
                                                  Label="重建索引"
                                                  Click="RebuildLocalSearchIndex_Click" />
                                </CommandBar>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryCheckpointsTab" Header="检查点" IsClosable="False">
                <ListView x:Name="CheckpointList"
                          IsItemClickEnabled="True"
                          ItemClick="CheckpointList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Summary}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceAgent}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock Text="{Binding CreatedAt}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock x:Uid="HistoryOpenSourceCheckpoint" Text="打开来源对话"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryHandoffsTab" Header="交接" IsClosable="False">
                <ListView x:Name="HandoffList"
                          IsItemClickEnabled="True"
                          ItemClick="HandoffList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding CurrentGoal}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FromAgent}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock Text="{Binding ToAgent}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock x:Uid="HistoryOpenSourceHandoff" Text="打开来源对话"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryRunsTab" Header="运行" IsClosable="False">
                <ListView x:Name="RunList"
                          IsItemClickEnabled="True"
                          ItemClick="RunList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock x:Uid="HistoryOpenSourceRun" Text="打开来源对话"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryArtifactsTab" Header="产物" IsClosable="False">
                <ListView x:Name="ArtifactList"
                          IsItemClickEnabled="True"
                          ItemClick="ArtifactList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock Text="{Binding TrustState}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock x:Uid="HistoryOpenArtifactSource" Text="查看产生该产物的对话"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryEpisodesTab" Header="经历" IsClosable="False">
                <ListView x:Name="EpisodeList"
                          IsItemClickEnabled="True"
                          ItemClick="EpisodeList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                    <TextBlock Text="{Binding Outcome}"
                                               Foreground="{ThemeResource SubtleTextBrush}" />
                                    <TextBlock x:Uid="HistoryOpenSourceEpisode" Text="打开来源对话"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryWikiTab" Header="Wiki" IsClosable="False">
                <ListView x:Name="WikiList"
                          IsItemClickEnabled="True"
                          ItemClick="WikiList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Body}"
                                               TextWrapping="Wrap"
                                               MaxLines="4" />
                                    <TextBlock x:Uid="HistoryOpenWiki" Text="查看完整页面"
                                               Foreground="{ThemeResource AIMemoryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem x:Uid="HistoryGraphTab" Header="实体图谱" IsClosable="False">
                <Grid>
                    <ListView x:Name="EntityList"
                              IsItemClickEnabled="True"
                              ItemClick="EntityList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="{Binding EntityName}"
                                                           FontWeight="SemiBold" />
                                                <Border Style="{ThemeResource TagChipStyle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}"
                                                               Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                               FontSize="12" />
                                                </Border>
                                                <TextBlock Text="{Binding MentionLabel}"
                                                           Foreground="{ThemeResource SubtleTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RelationshipLabel}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RepositoryRoot}"
                                                       FontFamily="Cascadia Mono"
                                                       Foreground="{ThemeResource SubtleTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Uid="HistoryGraphOpen"
                                                   Grid.Column="1"
                                                   Text="打开关联内容"
                                                   Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ActionVisibility}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoEntitiesText"
                               x:Uid="HistoryNoEntities"
                               Text="当前仓库尚无实体关系。批准记忆并重建索引后会生成。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SubtleTextBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </TabViewItem>
        </TabView>

        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="2"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
