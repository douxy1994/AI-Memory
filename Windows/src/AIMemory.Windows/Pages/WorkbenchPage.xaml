<Page
    x:Class="AIMemory.Windows.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32"
                    Spacing="20"
                    MaxWidth="1120"
                    HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="WorkbenchTitle" Text="继续工作"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Uid="WorkbenchSubtitle" Text="最近进度、项目分组、恢复命令和下一步集中在一个工作台。"
                               TextWrapping="Wrap"
                               Opacity="0.65" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="SourceFilterBox"
                              Width="180"
                              DisplayMemberPath="Label"
                              SelectionChanged="SourceFilterBox_SelectionChanged" />
                    <CommandBar Background="Transparent"
                                DefaultLabelPosition="Right">
                        <AppBarButton x:Uid="WorkbenchSync"
                                      Icon="Sync"
                                      Label="立即同步"
                                      Click="Sync_Click" />
                        <AppBarButton x:Uid="WorkbenchRefresh"
                                      Icon="Refresh"
                                      Label="刷新来源"
                                      Click="Refresh_Click" />
                        <AppBarButton x:Uid="WorkbenchHistory"
                                      Icon="Clock"
                                      Label="历史"
                                      Click="History_Click" />
                    </CommandBar>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8BD;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="CurrentSourceCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCurrentSourceCount" Text="本来源对话"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE7B8;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="AllConversationCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchAllAgentCount" Text="全 Agent 对话"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE73E;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="PendingCandidateCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchPendingCount" Text="待审候选"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3"
                        Style="{StaticResource CardStyle}"
                        MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE823;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="CheckpointCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCheckpointCount" Text="检查点"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WorkbenchRecentTasks" Text="最近任务"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <ListView x:Name="RecentConversationList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="RecentConversationList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Summary}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProjectPath}"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SourceAgent}"
                                                   Opacity="0.6" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoRecentText"
                                   x:Uid="WorkbenchNoRecent"
                                   Text="该来源还没有对话。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="WorkbenchProjects" Text="项目"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ManageMachineGroupsButton"
                                    x:Uid="WorkbenchManageMachines"
                                    Grid.Column="1"
                                    Content="管理电脑分组"
                                    Click="ManageMachineGroups_Click"
                                    IsEnabled="False" />
                        </Grid>
                        <ListView x:Name="ProjectList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ProjectList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LatestTitle}"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MachineLabel}"
                                                       Foreground="{StaticResource AIMemoryGreenBrush}"
                                                       Opacity="0.85"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CountLabel}"
                                                   Foreground="{StaticResource AIMemoryGreenBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoProjectsText"
                                   x:Uid="WorkbenchNoProjects"
                                   Text="该来源还没有项目。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchFavoritesPanel"
                                   Text="收藏夹增强"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchFavoritesPanelHint"
                                   Text="置顶、备注、标签和继续卡片。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="FavoriteCountText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <Button x:Uid="WorkbenchOpenFavorites"
                                Content="打开收藏"
                                HorizontalAlignment="Left"
                                Click="OpenFavorites_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchMemoryPanel"
                                   Text="项目记忆沉淀"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchMemoryPanelHint"
                                   Text="汇总已批准规则、候选记忆和 Wiki 页面。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="MemorySummaryText"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                        <Button x:Uid="WorkbenchOpenMemory"
                                Content="打开记忆"
                                HorizontalAlignment="Left"
                                Click="OpenMemory_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchRecommendationPanel"
                                   Text="跨 Agent 接续推荐"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchRecommendationPanelHint"
                                   Text="根据最近对话信号给出接续建议。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="RecommendedAgentText"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="RecommendationReasonText"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <Button x:Name="SwitchRecommendedAgentButton"
                                x:Uid="WorkbenchSwitchRecommendedAgent"
                                Content="切换来源"
                                HorizontalAlignment="Left"
                                Click="SwitchRecommendedAgent_Click"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="WorkbenchHighSignalPanel"
                                   Text="对话质量整理"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchHighSignalPanelHint"
                                   Text="优先展示包含文件、长上下文或已收藏的高信号对话。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <ListView x:Name="HighSignalList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="InsightList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,7" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoHighSignalText"
                                   x:Uid="WorkbenchNoHighSignal"
                                   Text="暂无高信号候选。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="WorkbenchCleanupPanel"
                                   Text="本地隐私与清理"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCleanupPanelHint"
                                   Text="仅列出低信号旧对话供确认，不自动删除。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <ListView x:Name="CleanupList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="InsightList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,7" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoCleanupText"
                                   x:Uid="WorkbenchNoCleanup"
                                   Text="暂时没有明显清理候选。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchReleasePanel"
                                   Text="发布准备状态"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchReleasePanelHint"
                                   Text="发布前检查版本、数据保护和更新通道。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ApplicationVersionText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DataDirectoryText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateChannelText"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchNativeParityPanel"
                                   Text="Windows 11 原生对等状态"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchNativeParityPanelHint"
                                   Text="关键能力使用 WinUI 3、Windows App SDK 与系统框架。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Uid="WorkbenchNativeHistory"
                                   Text="本地历史与搜索 · SQLite / .NET" />
                        <TextBlock x:Uid="WorkbenchNativeSync"
                                   Text="同步与凭据 · HttpClient / Credential Locker" />
                        <TextBlock x:Uid="WorkbenchNativeLifecycle"
                                   Text="窗口、菜单与通知区域 · WinUI 3 / Win32" />
                        <TextBlock x:Uid="WorkbenchNativeImport"
                                   Text="ChatMem 数据保护 · 只读导入 + 备份回滚" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkbenchInstalledAgents" Text="已安装的 Agent / CLI"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DetectedAgentSummary"
                               Opacity="0.6" />
                    <ItemsControl x:Name="AgentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Detail}"
                                               Opacity="0.6" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoAgentsText"
                               x:Uid="WorkbenchNoAgents"
                               Text="没有检测到本机 Agent；所有集成保持关闭。"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
