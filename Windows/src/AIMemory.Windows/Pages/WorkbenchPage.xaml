<Page
    x:Class="AIMemory.Windows.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32"
                    Spacing="20"
                    MaxWidth="1120"
                    HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="WorkbenchTitle" Text="继续工作"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Uid="WorkbenchSubtitle" Text="最近进度、项目分组、恢复命令和下一步集中在一个工作台。"
                               TextWrapping="Wrap"
                               Opacity="0.65" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="SourceFilterBox"
                              Width="180"
                              DisplayMemberPath="Label"
                              SelectionChanged="SourceFilterBox_SelectionChanged" />
                    <CommandBar Background="Transparent"
                                DefaultLabelPosition="Right">
                        <AppBarButton x:Uid="WorkbenchSync"
                                      Icon="Sync"
                                      Label="立即同步"
                                      Click="Sync_Click" />
                        <AppBarButton x:Uid="WorkbenchRefresh"
                                      Icon="Refresh"
                                      Label="刷新来源"
                                      Click="Refresh_Click" />
                        <AppBarButton x:Uid="WorkbenchHistory"
                                      Icon="Clock"
                                      Label="历史"
                                      Click="History_Click" />
                    </CommandBar>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8BD;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="CurrentSourceCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCurrentSourceCount" Text="本来源对话"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE7B8;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="AllConversationCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchAllAgentCount" Text="全 Agent 对话"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE73E;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="PendingCandidateCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchPendingCount" Text="待审候选"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3"
                        Style="{StaticResource CardStyle}"
                        MinHeight="132">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE823;"
                                  Foreground="{StaticResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="CheckpointCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCheckpointCount" Text="检查点"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WorkbenchRecentTasks" Text="最近任务"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <ListView x:Name="RecentConversationList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="RecentConversationList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Summary}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProjectPath}"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SourceAgent}"
                                                   Opacity="0.6" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoRecentText"
                                   x:Uid="WorkbenchNoRecent"
                                   Text="该来源还没有对话。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="WorkbenchProjects" Text="项目"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ManageMachineGroupsButton"
                                    x:Uid="WorkbenchManageMachines"
                                    Grid.Column="1"
                                    Content="管理电脑分组"
                                    Click="ManageMachineGroups_Click"
                                    IsEnabled="False" />
                        </Grid>
                        <ListView x:Name="ProjectList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ProjectList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LatestTitle}"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MachineLabel}"
                                                       Foreground="{StaticResource AIMemoryGreenBrush}"
                                                       Opacity="0.85"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CountLabel}"
                                                   Foreground="{StaticResource AIMemoryGreenBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoProjectsText"
                                   x:Uid="WorkbenchNoProjects"
                                   Text="该来源还没有项目。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkbenchInstalledAgents" Text="已安装的 Agent / CLI"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DetectedAgentSummary"
                               Opacity="0.6" />
                    <ItemsControl x:Name="AgentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Detail}"
                                               Opacity="0.6" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoAgentsText"
                               x:Uid="WorkbenchNoAgents"
                               Text="没有检测到本机 Agent；所有集成保持关闭。"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
