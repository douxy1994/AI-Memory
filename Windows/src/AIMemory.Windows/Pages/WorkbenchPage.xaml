<Page
    x:Class="AIMemory.Windows.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WindowBackgroundBrush}">
    <ScrollViewer>
        <StackPanel Padding="32"
                    Spacing="20"
                    MaxWidth="1120"
                    HorizontalAlignment="Stretch">
            <Border Style="{ThemeResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock x:Uid="WorkbenchTitle" Text="继续工作"
                                       Style="{ThemeResource PageTitleStyle}" />
                            <TextBlock x:Uid="WorkbenchSubtitle" Text="把最近进度、恢复命令、项目记忆和下一步集中在一个工作台里。"
                                       Style="{ThemeResource PageSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Top">
                            <Button Width="34" Height="34" Padding="0"
                                    Style="{ThemeResource GhostPillButtonStyle}"
                                    ToolTipService.ToolTip="立即同步"
                                    Click="Sync_Click">
                                <SymbolIcon Symbol="Sync" />
                            </Button>
                            <Button Width="34" Height="34" Padding="0"
                                    Style="{ThemeResource GhostPillButtonStyle}"
                                    ToolTipService.ToolTip="刷新当前来源"
                                    Click="Refresh_Click">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button Width="34" Height="34" Padding="0"
                                    Style="{ThemeResource GhostPillButtonStyle}"
                                    ToolTipService.ToolTip="历史"
                                    Click="History_Click">
                                <SymbolIcon Symbol="Clock" />
                            </Button>
                            <Border Background="{ThemeResource AIMemoryGreenSoftBrush}"
                                    CornerRadius="16" Padding="10,6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SymbolIcon Symbol="Message" />
                                    <TextBlock x:Name="HeroConversationCount" x:Uid="WorkbenchHeroConversationCount" Text="0 条对话"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ComboBox x:Name="SourceFilterBox"
                              Width="150"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Label"
                              SelectionChanged="SourceFilterBox_SelectionChanged" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{ThemeResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8BD;"
                                  Foreground="{ThemeResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="CurrentSourceCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCurrentSourceCount" Text="本来源对话"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Style="{ThemeResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE7B8;"
                                  Foreground="{ThemeResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="AllConversationCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchAllAgentCount" Text="全 Agent 对话"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Style="{ThemeResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE73E;"
                                  Foreground="{ThemeResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="PendingCandidateCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchPendingCount" Text="待审候选"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3"
                        Style="{ThemeResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE823;"
                                  Foreground="{ThemeResource AIMemoryGreenBrush}" />
                        <TextBlock x:Name="CheckpointCount"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCheckpointCount" Text="检查点"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="WorkbenchRecentTasks" Text="最近任务"
                               Style="{ThemeResource SectionTitleStyle}" />
                    <ListView x:Name="RecentConversationList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="RecentConversationList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{ThemeResource CardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Summary}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProjectPath}"
                                                       Foreground="{ThemeResource SubtleTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SourceAgent}"
                                                   Foreground="{ThemeResource SubtleTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoRecentText"
                               x:Uid="WorkbenchNoRecent"
                               Text="该来源还没有对话。"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock x:Uid="WorkbenchProjects" Text="项目"
                               Style="{ThemeResource SectionTitleStyle}"
                               VerticalAlignment="Center" />
                    <ListView x:Name="ProjectList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ProjectList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{ThemeResource CardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LatestTitle}"
                                                       Foreground="{ThemeResource SubtleTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MachineLabel}"
                                                       Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                       Opacity="0.85"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CountLabel}"
                                                   Foreground="{ThemeResource AIMemoryGreenBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoProjectsText"
                               x:Uid="WorkbenchNoProjects"
                               Text="该来源还没有项目。"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchFavoritesPanel"
                                   Text="收藏夹增强"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchFavoritesPanelHint"
                                   Text="置顶、备注、标签和继续卡片。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="FavoriteCountText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <Button x:Uid="WorkbenchOpenFavorites"
                                Content="打开收藏"
                                Style="{ThemeResource GhostPillButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OpenFavorites_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchMemoryPanel"
                                   Text="项目记忆沉淀"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchMemoryPanelHint"
                                   Text="汇总已批准规则、候选记忆和 Wiki 页面。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="MemorySummaryText"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                        <Button x:Uid="WorkbenchOpenMemory"
                                Content="打开记忆"
                                Style="{ThemeResource GhostPillButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OpenMemory_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchRecommendationPanel"
                                   Text="跨 Agent 接续推荐"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchRecommendationPanelHint"
                                   Text="根据最近对话信号给出接续建议。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="RecommendedAgentText"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="RecommendationReasonText"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <Button x:Name="SwitchRecommendedAgentButton"
                                x:Uid="WorkbenchSwitchRecommendedAgent"
                                Content="切换来源"
                                Style="{ThemeResource GhostPillButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="SwitchRecommendedAgent_Click"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="WorkbenchHighSignalPanel"
                                   Text="对话质量整理"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchHighSignalPanelHint"
                                   Text="优先展示包含文件、长上下文或已收藏的高信号对话。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <ListView x:Name="HighSignalList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="InsightList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,7" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoHighSignalText"
                                   x:Uid="WorkbenchNoHighSignal"
                                   Text="暂无高信号候选。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="WorkbenchCleanupPanel"
                                   Text="本地隐私与清理"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchCleanupPanelHint"
                                   Text="仅列出低信号旧对话供确认，不自动删除。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <ListView x:Name="CleanupList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="InsightList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,7" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoCleanupText"
                                   x:Uid="WorkbenchNoCleanup"
                                   Text="暂时没有明显清理候选。"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchReleasePanel"
                                   Text="发布准备状态"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchReleasePanelHint"
                                   Text="发布前检查版本、数据保护和更新通道。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ApplicationVersionText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DataDirectoryText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateChannelText"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock x:Uid="WorkbenchNativeParityPanel"
                                   Text="Windows 11 原生对等状态"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="WorkbenchNativeParityPanelHint"
                                   Text="关键能力使用 WinUI 3、Windows App SDK 与系统框架。"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Uid="WorkbenchNativeHistory"
                                   Text="本地历史与搜索 · SQLite / .NET" />
                        <TextBlock x:Uid="WorkbenchNativeSync"
                                   Text="同步与凭据 · HttpClient / Credential Locker" />
                        <TextBlock x:Uid="WorkbenchNativeLifecycle"
                                   Text="窗口、菜单与通知区域 · WinUI 3 / Win32" />
                        <TextBlock x:Uid="WorkbenchNativeImport"
                                   Text="ChatMem 数据保护 · 只读导入 + 备份回滚" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{ThemeResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WorkbenchInstalledAgents" Text="已安装的 Agent / CLI"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DetectedAgentSummary"
                               Opacity="0.6" />
                    <ItemsControl x:Name="AgentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Detail}"
                                               Opacity="0.6" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoAgentsText"
                               x:Uid="WorkbenchNoAgents"
                               Text="没有检测到本机 Agent；所有集成保持关闭。"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
