<Page
    x:Class="AIMemory.Windows.Pages.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WindowBackgroundBrush}">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{ThemeResource CardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="TrashTitle" Text="回收站" Style="{ThemeResource PageTitleStyle}" />
                    <TextBlock x:Name="TrashSummaryText"
                               x:Uid="TrashSummary"
                               Text="已删除对话的可恢复记录。"
                               Style="{ThemeResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock x:Uid="TrashRetentionDays" Text="保留天数" VerticalAlignment="Center" />
                    <NumberBox x:Name="TrashRetentionBox"
                               Width="100"
                               Minimum="1"
                               Maximum="365"
                               SmallChange="1"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="TrashRetentionBox_ValueChanged" />
                    <Button x:Name="EmptyTrashButton"
                            x:Uid="TrashEmptyButton"
                            Content="清空"
                            Style="{ThemeResource GhostPillButtonStyle}"
                            Click="EmptyTrash_Click" />
                    <Button x:Uid="TrashRefresh"
                            Content="刷新"
                            Style="{ThemeResource GhostPillButtonStyle}"
                            Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="TrashList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{ThemeResource CardStyle}" Margin="0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Agent}"
                                           Foreground="{ThemeResource SubtleTextBrush}" />
                                <TextBlock Text="{Binding ExpiresAt}"
                                           Foreground="{ThemeResource SubtleTextBrush}" />
                            </StackPanel>
                            <CommandBar Grid.Column="1"
                                        Background="Transparent"
                                        DefaultLabelPosition="Right">
                                <AppBarButton x:Uid="TrashRestore"
                                              Icon="Undo"
                                              Label="恢复"
                                              Tag="{Binding}"
                                              Click="Restore_Click" />
                                <AppBarButton x:Uid="TrashDelete"
                                              Icon="Delete"
                                              Label="永久删除"
                                              Tag="{Binding}"
                                              Click="Delete_Click" />
                            </CommandBar>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border x:Name="EmptyText"
                Grid.Row="1"
                Style="{ThemeResource HintBannerStyle}"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <TextBlock x:Uid="TrashEmpty"
                       Text="回收站为空。在对话详情点击“移到回收站”后，对话会在此保留并可恢复。"
                       TextWrapping="Wrap" />
        </Border>
        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="2"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
