<Page
    x:Class="AIMemory.Windows.Pages.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="TrashTitle" Text="回收站" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="TrashSummaryText"
                           x:Uid="TrashSummary"
                           Text="已删除对话的可恢复记录。"
                           TextWrapping="Wrap"
                           Opacity="0.65" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock x:Uid="TrashRetentionDays" Text="保留天数" VerticalAlignment="Center" />
                <NumberBox x:Name="TrashRetentionBox"
                           Width="100"
                           Minimum="1"
                           Maximum="365"
                           SmallChange="1"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="TrashRetentionBox_ValueChanged" />
                <Button x:Name="EmptyTrashButton"
                        x:Uid="TrashEmptyButton"
                        Content="清空"
                        Click="EmptyTrash_Click" />
                <Button x:Uid="TrashRefresh" Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <ListView x:Name="TrashList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Agent}" Opacity="0.6" />
                                <TextBlock Text="{Binding ExpiresAt}"
                                           Opacity="0.6" />
                            </StackPanel>
                            <CommandBar Grid.Column="1"
                                        Background="Transparent"
                                        DefaultLabelPosition="Right">
                                <AppBarButton x:Uid="TrashRestore"
                                              Icon="Undo"
                                              Label="恢复"
                                              Tag="{Binding}"
                                              Click="Restore_Click" />
                                <AppBarButton x:Uid="TrashDelete"
                                              Icon="Delete"
                                              Label="永久删除"
                                              Tag="{Binding}"
                                              Click="Delete_Click" />
                            </CommandBar>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText"
                   x:Uid="TrashEmpty"
                   Grid.Row="1"
                   Text="回收站为空。在对话详情点击“移到回收站”后，对话会在此保留并可恢复。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Opacity="0.6"
                   Visibility="Collapsed" />
        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="2"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
