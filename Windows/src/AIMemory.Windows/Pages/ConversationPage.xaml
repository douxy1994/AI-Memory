<Page
    x:Class="AIMemory.Windows.Pages.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="LoadingPanel"
              Padding="32"
              Visibility="Visible">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsActive="True"
                              Width="34"
                              Height="34"
                              HorizontalAlignment="Center" />
                <TextBlock x:Uid="ConversationLoadingDetail"
                           Text="正在读取完整对话…"
                           FontSize="16"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ErrorPanel"
              Padding="32"
              Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <FontIcon Glyph="&#xEA39;"
                              FontSize="28"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Uid="ConversationLoadFailedTitle"
                               Text="无法读取对话"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ErrorDetailText"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Opacity="0.72" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button x:Uid="ConversationBackFromError"
                                Content="返回历史"
                                Click="Back_Click" />
                        <Button x:Uid="ConversationRetry"
                                Content="重试"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Retry_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DetailContent"
              Padding="32"
              RowSpacing="14"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource PageTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MetadataText"
                               TextWrapping="Wrap"
                               Opacity="0.65" />
                </StackPanel>
                <CommandBar Grid.Column="1"
                            Background="Transparent"
                            DefaultLabelPosition="Right">
                    <AppBarButton x:Uid="ConversationBack"
                                  Icon="Back"
                                  Label="返回"
                                  Click="Back_Click" />
                    <AppBarButton x:Name="FavoriteButton"
                                  x:Uid="ConversationFavorite"
                                  Icon="Favorite"
                                  Label="收藏"
                                  Click="Favorite_Click" />
                    <AppBarButton x:Uid="ConversationCopyPath"
                                  Icon="Copy"
                                  Label="复制路径"
                                  Click="CopyPath_Click" />
                    <AppBarButton x:Uid="ConversationMigrate"
                                  Icon="Forward"
                                  Label="迁移"
                                  Click="Migrate_Click" />
                    <AppBarButton x:Uid="ConversationTrash"
                                  Icon="Delete"
                                  Label="移到回收站"
                                  Click="Trash_Click" />
                    <AppBarSeparator />
                    <AppBarButton x:Uid="ConversationCheckpoint"
                                  Icon="SaveLocal"
                                  Label="创建检查点"
                                  Click="CreateCheckpoint_Click" />
                </CommandBar>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="MessageCountText"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="ConversationMessages" Text="消息" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="FileCountText"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="ConversationFileChangesMetric" Text="文件变更" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="ToolCallCountText"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="ConversationToolCalls" Text="工具调用" Opacity="0.6" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <ListView x:Name="MessageList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RoleLabel}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AIMemoryGreenBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimestampLabel}"
                                                       Opacity="0.5" />
                                        </Grid>
                                        <TextBlock Text="{Binding Content}"
                                                   Visibility="{Binding ContentVisibility}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                        <Border Visibility="{Binding ToolCallsVisibility}"
                                                Background="{StaticResource AIMemoryGreenSoftBrush}"
                                                CornerRadius="8"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding ToolCallsHeader}"
                                                           FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding ToolCalls}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Padding="8"
                                                                    Margin="0,2">
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontFamily="Cascadia Mono"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding InputPreview}"
                                                                                       FontFamily="Cascadia Mono"
                                                                                       FontSize="12"
                                                                                       TextWrapping="Wrap"
                                                                                       MaxLines="2"
                                                                                       Opacity="0.68" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="1"
                                                                                Background="{StaticResource AIMemoryGreenSoftBrush}"
                                                                                CornerRadius="8"
                                                                                Padding="7,2">
                                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                                       FontSize="12" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <Expander x:Uid="ConversationToolCallDetails"
                                                                              Header="查看参数与输出">
                                                                        <StackPanel Spacing="6"
                                                                                    Padding="0,8,0,0">
                                                                            <TextBlock x:Uid="ConversationToolCallInput"
                                                                                       Text="输入"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding InputDetails}"
                                                                                     IsReadOnly="True"
                                                                                     TextWrapping="Wrap"
                                                                                     FontFamily="Cascadia Mono"
                                                                                     FontSize="12" />
                                                                            <TextBlock x:Uid="ConversationToolCallOutput"
                                                                                       Text="输出"
                                                                                       Visibility="{Binding OutputVisibility}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding OutputText}"
                                                                                     Visibility="{Binding OutputVisibility}"
                                                                                     IsReadOnly="True"
                                                                                     TextWrapping="Wrap"
                                                                                     FontFamily="Cascadia Mono"
                                                                                     FontSize="12" />
                                                                            <TextBlock x:Uid="ConversationToolCallNoOutput"
                                                                                       Text="这次工具调用没有返回内容。"
                                                                                       Visibility="{Binding NoOutputVisibility}"
                                                                                       Opacity="0.62" />
                                                                        </StackPanel>
                                                                    </Expander>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="NoMessagesPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8BD;"
                                  FontSize="28"
                                  Opacity="0.55" />
                        <TextBlock x:Uid="ConversationNoMessages"
                                   Text="这段对话还没有可显示的消息。"
                                   TextWrapping="Wrap"
                                   Opacity="0.65" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="ConversationResumeTitle" Text="可恢复进度"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <StackPanel x:Name="ResumePanel"
                                            Spacing="8"
                                            Visibility="Collapsed">
                                    <TextBlock x:Uid="ConversationResumeCommand" Text="恢复命令" Opacity="0.6" />
                                    <TextBox x:Name="ResumeCommandBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Cascadia Mono" />
                                    <Button x:Uid="ConversationCopyResume" Content="复制恢复命令"
                                            HorizontalAlignment="Right"
                                            Click="CopyResume_Click" />
                                </StackPanel>
                                <TextBlock x:Uid="ConversationStorageLocation" Text="存储位置" Opacity="0.6" />
                                <TextBlock x:Name="StoragePathText"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="ConversationFileChangesTitle" Text="文件变更"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <ListView x:Name="FileChangeList"
                                          SelectionMode="None"
                                          MaxHeight="280">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="0,6" Spacing="2">
                                                <TextBlock Text="{Binding Path}"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Cascadia Mono" />
                                                <TextBlock Text="{Binding ChangeType}"
                                                           Opacity="0.6" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="NoFileChangesText"
                                           x:Uid="ConversationNoFileChanges"
                                           Text="这段对话没有记录文件变更。"
                                           TextWrapping="Wrap"
                                           Opacity="0.6"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="ConversationHandoffTitle" Text="Agent 交接"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <ComboBox x:Name="TargetAgentBox"
                                          x:Uid="ConversationTargetAgent"
                                          PlaceholderText="目标 Agent"
                                          DisplayMemberPath="Label" />
                                <Button x:Uid="ConversationCreateHandoff" Content="创建交接包"
                                        HorizontalAlignment="Right"
                                        Click="CreateHandoff_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <InfoBar x:Name="Feedback"
                 VerticalAlignment="Bottom"
                 Margin="44"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
