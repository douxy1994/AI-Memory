<Page
    x:Class="AIMemory.Windows.Pages.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="Back_Click" />
            <StackPanel Margin="52,0,0,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="MetadataText" Opacity="0.65" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="创建检查点" Click="CreateCheckpoint_Click" />
                <ComboBox x:Name="TargetAgentBox"
                          Width="170"
                          PlaceholderText="目标 Agent"
                          DisplayMemberPath="Label" />
                <Button Content="创建交接" Click="CreateHandoff_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
        <ListView x:Name="MessageList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{StaticResource AIMemoryGreenBrush}" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding Timestamp}" Opacity="0.5" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar x:Name="Feedback"
                 VerticalAlignment="Bottom"
                 Margin="12"
                 IsOpen="False"
                 IsClosable="True" />
        </Grid>
    </Grid>
</Page>
