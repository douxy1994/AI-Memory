<Page
    x:Class="AIMemory.Windows.Pages.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource PageTitleStyle}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MetadataText"
                           TextWrapping="Wrap"
                           Opacity="0.65" />
            </StackPanel>
            <CommandBar Grid.Column="1"
                        Background="Transparent"
                        DefaultLabelPosition="Right">
                <AppBarButton Icon="Back"
                              Label="返回"
                              Click="Back_Click" />
                <AppBarButton x:Name="FavoriteButton"
                              Icon="Favorite"
                              Label="收藏"
                              Click="Favorite_Click" />
                <AppBarButton Icon="Copy"
                              Label="复制路径"
                              Click="CopyPath_Click" />
                <AppBarButton Icon="Delete"
                              Label="移到回收站"
                              Click="Trash_Click" />
                <AppBarSeparator />
                <AppBarButton Icon="SaveLocal"
                              Label="创建检查点"
                              Click="CreateCheckpoint_Click" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="MessageCountText"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="消息" Opacity="0.6" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="12">
                <StackPanel>
                    <TextBlock x:Name="FileCountText"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="文件变更" Opacity="0.6" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="12">
                <StackPanel>
                    <TextBlock x:Name="ToolCallCountText"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="工具调用" Opacity="0.6" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="MessageList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,4">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Role}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AIMemoryGreenBrush}" />
                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding Timestamp}"
                                           Opacity="0.5"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="可恢复进度"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="ResumePanel"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                <TextBlock Text="恢复命令" Opacity="0.6" />
                                <TextBox x:Name="ResumeCommandBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono" />
                                <Button Content="复制恢复命令"
                                        HorizontalAlignment="Right"
                                        Click="CopyResume_Click" />
                            </StackPanel>
                            <TextBlock Text="存储位置" Opacity="0.6" />
                            <TextBlock x:Name="StoragePathText"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="文件变更"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <ListView x:Name="FileChangeList"
                                      SelectionMode="None"
                                      MaxHeight="280">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Text="{Binding Path}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Cascadia Mono" />
                                            <TextBlock Text="{Binding ChangeType}"
                                                       Opacity="0.6" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NoFileChangesText"
                                       Text="这段对话没有记录文件变更。"
                                       TextWrapping="Wrap"
                                       Opacity="0.6"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Agent 交接"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="TargetAgentBox"
                                      PlaceholderText="目标 Agent"
                                      DisplayMemberPath="Label" />
                            <Button Content="创建交接包"
                                    HorizontalAlignment="Right"
                                    Click="CreateHandoff_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <InfoBar x:Name="Feedback"
                     Grid.ColumnSpan="2"
                     VerticalAlignment="Bottom"
                     Margin="12"
                     IsOpen="False"
                     IsClosable="True" />
        </Grid>
    </Grid>
</Page>
