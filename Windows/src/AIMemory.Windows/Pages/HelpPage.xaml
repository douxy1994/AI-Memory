<Page
    x:Class="AIMemory.Windows.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="18"
          Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="HelpPageTitle"
                       Text="需要帮助？"
                       Style="{ThemeResource PageTitleStyle}" />
            <TextBlock x:Uid="HelpSubtitle"
                       Text="从常见问题开始，直接打开相应的可用功能。"
                       Style="{ThemeResource PageSubtitleStyle}" />
        </StackPanel>

        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 x:Uid="HelpSearch"
                 PlaceholderText="搜索问题"
                 TextChanged="SearchBox_TextChanged" />

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Stretch"
                        Spacing="16">
                <TextBlock x:Uid="HelpTopicsTitle"
                           Text="常见问题"
                           Style="{ThemeResource SectionTitleStyle}" />

                <ListView x:Name="TopicList"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{ThemeResource CardStyle}"
                                    Margin="0,0,0,8">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.68" />
                                        <TextBlock Text="{Binding Answer}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.82" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding ActionLabel}"
                                            Tag="{Binding}"
                                            Style="{ThemeResource GhostPillButtonStyle}"
                                            VerticalAlignment="Center"
                                            Click="OpenTopic_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="NoResultsText"
                           x:Uid="HelpNoSearchResults"
                           Text="没有匹配的问题。"
                           HorizontalAlignment="Center"
                           Margin="0,12"
                           Opacity="0.65"
                           Visibility="Collapsed" />

                <Border Style="{ThemeResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="HelpHowItWorksTitle"
                                   Text="后台工作方式"
                                   Style="{ThemeResource SectionTitleStyle}" />
                        <TextBlock x:Uid="HelpHowItWorksData"
                                   Text="本机数据：对话、恢复点和设置都保存在当前 Windows 用户的数据目录中。"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock x:Uid="HelpHowItWorksSync"
                                   Text="增量同步：WebDAV 与本地同步目录只处理发生变化的对话，完成后显示上传、下载和跳过数量。"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock x:Uid="HelpHowItWorksIntegrations"
                                   Text="Agent 集成：只为已检测到且支持自动配置的 Agent 写入 AI Memory 托管的 MCP、skill 和启动规则。"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Expander x:Uid="HelpDiagnostics"
                          Header="高级排障">
                    <Border Style="{ThemeResource CardStyle}"
                            Margin="0,10,0,0">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock x:Uid="HelpDiagnosticDatabase"
                                           Text="数据库"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DatabasePathText"
                                           FontFamily="Cascadia Mono"
                                           FontSize="12"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock x:Uid="HelpDiagnosticSettings"
                                           Text="设置文件"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SettingsPathText"
                                           FontFamily="Cascadia Mono"
                                           FontSize="12"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                            </StackPanel>
                            <CommandBar Background="Transparent"
                                        HorizontalAlignment="Right"
                                        DefaultLabelPosition="Right">
                                <AppBarButton x:Uid="HelpOpenDataFolder"
                                              Icon="Folder"
                                              Label="打开数据目录"
                                              Click="OpenDataFolder_Click" />
                                <AppBarButton x:Uid="HelpCopyDiagnostics"
                                              Icon="Copy"
                                              Label="复制诊断"
                                              Click="CopyDiagnostics_Click" />
                                <AppBarButton x:Uid="HelpReturnWorkbench"
                                              Icon="Back"
                                              Label="返回工作台"
                                              Click="ReturnToWorkbench_Click" />
                            </CommandBar>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="Feedback"
                 Grid.RowSpan="3"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
