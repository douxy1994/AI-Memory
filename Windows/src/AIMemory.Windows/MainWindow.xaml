<Window
    x:Class="AIMemory.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Image Source="Assets/AppIcon.png" Width="30" Height="30" />
                <TextBlock Text="AI Memory"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <MenuBar x:Name="MainMenuBar" Grid.Row="1">
            <MenuBarItem x:Uid="MenuFile" Title="文件">
                <MenuFlyoutItem x:Uid="MenuImportChatMem"
                                Text="从 ChatMem 导入…"
                                KeyboardAcceleratorTextOverride="Ctrl+I"
                                Click="ImportChatMemMenu_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuCloseWindow"
                                Text="关闭窗口"
                                KeyboardAcceleratorTextOverride="Ctrl+W"
                                Click="CloseWindowMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuWorkbench" Title="工作台">
                <MenuFlyoutItem x:Uid="MenuReturnWorkbench" Text="返回工作台"
                                KeyboardAcceleratorTextOverride="Ctrl+1"
                                Click="WorkbenchMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuReview" Text="待复核"
                                KeyboardAcceleratorTextOverride="Ctrl+2"
                                Click="ReviewMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuHistory" Text="历史"
                                KeyboardAcceleratorTextOverride="Ctrl+3"
                                Click="HistoryMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuMemory" Text="记忆"
                                KeyboardAcceleratorTextOverride="Ctrl+Alt+M"
                                Click="MemoryMenu_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuSyncNow" Text="立即同步"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                                Click="SyncMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuRefreshSources" Text="刷新全部来源"
                                KeyboardAcceleratorTextOverride="Ctrl+R"
                                Click="RefreshSourcesMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuWindow" Title="窗口">
                <MenuFlyoutItem x:Uid="MenuBack" Text="返回上一页"
                                KeyboardAcceleratorTextOverride="Alt+Left"
                                Click="BackMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuSettings" Text="设置"
                                KeyboardAcceleratorTextOverride="Ctrl+,"
                                Click="SettingsMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuHelp" Title="帮助">
                <MenuFlyoutItem x:Uid="MenuHelpItem" Text="AI Memory 帮助"
                                KeyboardAcceleratorTextOverride="F1"
                                Click="HelpMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuAbout" Text="关于 AI Memory"
                                Click="AboutMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuCheckUpdates" Text="检查更新"
                                Click="CheckUpdatesMenu_Click" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="2">
            <NavigationView x:Name="Navigation"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="True"
                            PaneDisplayMode="Left"
                            SelectionChanged="Navigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="NavigationWorkbench" Content="工作台" Tag="workbench">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="NavigationHistory" Content="历史" Tag="history">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="NavigationMemory" Content="记忆" Tag="memory">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Uid="NavigationFavorites" Content="收藏" Tag="favorites">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Favorite" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="NavigationTrash" Content="回收站" Tag="trash">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" />
            </NavigationView>
            <StackPanel VerticalAlignment="Bottom"
                        Margin="16"
                        Spacing="6">
                <ProgressBar x:Name="GlobalProgress"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
                <TextBlock x:Name="GlobalProgressText"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Visibility="Collapsed" />
                <InfoBar x:Name="GlobalFeedback"
                         IsOpen="False"
                         IsClosable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
