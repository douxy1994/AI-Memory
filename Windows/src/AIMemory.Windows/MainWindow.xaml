<Window
    x:Class="AIMemory.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIMemory.Windows">
    <Grid x:Name="RootLayout" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource WindowBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Border Width="34" Height="34" CornerRadius="8">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="34" Height="34" />
                </Border>
                <TextBlock Text="AI Memory"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <MenuBar x:Name="MainMenuBar"
                 Grid.Row="0"
                 Margin="8,0,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Background="Transparent">
            <MenuBarItem x:Uid="MenuFile" Title="文件">
                <MenuFlyoutItem x:Uid="MenuImportChatMem"
                                Text="从 ChatMem 导入…"
                                KeyboardAcceleratorTextOverride="Ctrl+I"
                                Click="ImportChatMemMenu_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuCloseWindow"
                                Text="关闭窗口"
                                KeyboardAcceleratorTextOverride="Ctrl+W"
                                Click="CloseWindowMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuWorkbench" Title="工作台">
                <MenuFlyoutItem x:Uid="MenuReturnWorkbench" Text="返回工作台"
                                KeyboardAcceleratorTextOverride="Ctrl+1"
                                Click="WorkbenchMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuReview" Text="待复核"
                                KeyboardAcceleratorTextOverride="Ctrl+2"
                                Click="ReviewMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuHistory" Text="历史"
                                KeyboardAcceleratorTextOverride="Ctrl+3"
                                Click="HistoryMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuMemory" Text="记忆"
                                KeyboardAcceleratorTextOverride="Ctrl+Alt+M"
                                Click="MemoryMenu_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuSyncNow" Text="立即同步"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                                Click="SyncMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuRefreshSources" Text="刷新全部来源"
                                KeyboardAcceleratorTextOverride="Ctrl+R"
                                Click="RefreshSourcesMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuWindow" Title="窗口">
                <MenuFlyoutItem x:Uid="MenuBack" Text="返回上一页"
                                KeyboardAcceleratorTextOverride="Alt+Left"
                                Click="BackMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuSettings" Text="设置"
                                KeyboardAcceleratorTextOverride="Ctrl+,"
                                Click="SettingsMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuHelp" Title="帮助">
                <MenuFlyoutItem x:Uid="MenuHelpItem" Text="AI Memory 帮助"
                                KeyboardAcceleratorTextOverride="F1"
                                Click="HelpMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuAbout" Text="关于 AI Memory"
                                Click="AboutMenu_Click" />
                <MenuFlyoutItem x:Uid="MenuCheckUpdates" Text="检查更新"
                                Click="CheckUpdatesMenu_Click" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:SidebarView x:Name="Sidebar" />
            <Frame x:Name="ContentFrame" Grid.Column="1" />
            <Grid x:Name="StartupOverlay"
                  Grid.ColumnSpan="2"
                  Canvas.ZIndex="10"
                  Background="{ThemeResource WindowBackgroundBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            MaxWidth="460">
                    <ProgressRing x:Name="StartupProgress"
                                  IsActive="True"
                                  Width="34"
                                  Height="34"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource AIMemoryGreenBrush}" />
                    <TextBlock x:Name="StartupStatusText"
                               x:Uid="StartupLoading"
                               Text="正在启动 AI Memory…"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="16"
                        Spacing="6">
                <ProgressBar x:Name="GlobalProgress"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{ThemeResource AIMemoryGreenBrush}" />
                <TextBlock x:Name="GlobalProgressText"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Visibility="Collapsed" />
                <InfoBar x:Name="GlobalFeedback"
                         IsOpen="False"
                         IsClosable="True" />
            </StackPanel>
            <Button x:Name="BackToWorkbenchButton"
                    Grid.Column="1"
                    Canvas.ZIndex="5"
                    Style="{ThemeResource BackFabStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,36"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    AutomationProperties.Name="返回工作台"
                    Click="ReturnWorkbench_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1"
                       Canvas.ZIndex="5"
                       Text="v0.1.0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,18,12"
                       FontSize="11"
                       Foreground="{ThemeResource SubtleTextBrush}" />
        </Grid>
    </Grid>
</Window>
