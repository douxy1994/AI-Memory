<Application
    x:Class="AIMemory.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- macOS design tokens; light/dark follow the system theme -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AIMemoryWindow">#F3F7EE</Color>
                    <Color x:Key="AIMemorySidebar">#F6F8F2</Color>
                    <Color x:Key="AIMemoryCard">#F0FFFFFF</Color>
                    <Color x:Key="AIMemoryCardBorder">#14000000</Color>
                    <Color x:Key="AIMemorySubtleText">#6B786E</Color>
                    <Color x:Key="AIMemoryHintBanner">#FBF6E4</Color>
                    <Color x:Key="AIMemoryGreenSoft">#1F3A8F64</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AIMemoryWindow">#1E241E</Color>
                    <Color x:Key="AIMemorySidebar">#232B23</Color>
                    <Color x:Key="AIMemoryCard">#293129</Color>
                    <Color x:Key="AIMemoryCardBorder">#3A4436</Color>
                    <Color x:Key="AIMemorySubtleText">#9AA596</Color>
                    <Color x:Key="AIMemoryHintBanner">#3A3626</Color>
                    <Color x:Key="AIMemoryGreenSoft">#3D2F9E68</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="AIMemoryGreen">#3A8F64</Color>
            <SolidColorBrush x:Key="AIMemoryGreenBrush" Color="{StaticResource AIMemoryGreen}" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource AIMemoryWindow}" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource AIMemorySidebar}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource AIMemoryCard}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource AIMemoryCardBorder}" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource AIMemorySubtleText}" />
            <SolidColorBrush x:Key="HintBannerBrush" Color="{ThemeResource AIMemoryHintBanner}" />
            <SolidColorBrush x:Key="AIMemoryGreenSoftBrush" Color="{ThemeResource AIMemoryGreenSoft}" />

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AIMemoryGreenBrush}" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="StatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="MinHeight" Value="132" />
            </Style>
            <Style x:Key="HintBannerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HintBannerBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,10" />
            </Style>
            <Style x:Key="TagChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AIMemoryGreenSoftBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <Style x:Key="PrimaryPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AIMemoryGreenBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{ThemeResource AIMemoryGreenBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
            <Style x:Key="GhostPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AIMemoryGreenSoftBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AIMemoryGreenBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
            <Style x:Key="BackFabStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AIMemoryGreenBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{ThemeResource AIMemoryGreenBrush}" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
