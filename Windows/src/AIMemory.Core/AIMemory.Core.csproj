<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.3</Version>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
    <FileVersion>0.1.3.0</FileVersion>
    <RootNamespace>AIMemory.Core</RootNamespace>
    <Authors>douxy1994</Authors>
    <Copyright>Copyright © 2026 douxy1994</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/douxy1994/AI-Memory</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.x still declares the legacy 2.1.11
         SQLitePCLRaw floor. Direct references force the patched 3.x native
         bundle and prevent the vulnerable e_sqlite3 package from restoring. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence\SchemaV1.sql" />
  </ItemGroup>
</Project>
