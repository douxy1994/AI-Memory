<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>AIMemory.Setup</RootNamespace>
    <AssemblyName>AI-Memory-0.1.3-Windows-x64-Setup</AssemblyName>
    <Version>0.1.3</Version>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
    <FileVersion>0.1.3.0</FileVersion>
    <ApplicationIcon>..\src\AIMemory.Windows\Assets\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <Target Name="RequireMsixPayload" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MsixPath)' == ''"
           Text="MsixPath must point to the final x64 MSIX payload." />
    <Error Condition="!Exists('$(MsixPath)')"
           Text="MSIX payload does not exist: $(MsixPath)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(MsixPath)"
                      LogicalName="AIMemory.Windows.msix" />
  </ItemGroup>
</Project>
